# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# Google Analytics (Firebase → Project settings → Your apps → measurementId, "G-…"). Empty = no GA, no consent banner.
VITE_FB_MEASUREMENT_ID=

# Cloudflare Web Analytics site token (dash.cloudflare.com → Web Analytics → Add site). Empty = no beacon.
VITE_CF_BEACON_TOKEN=

# Comma-separated uids that may use the admin panel in Developer tools (mirror of isAdmin() in firestore.rules)
VITE_ADMIN_UIDS=

# Set to true to talk to local emulators (npm run dev:emu does this)
VITE_USE_EMULATORS=false
