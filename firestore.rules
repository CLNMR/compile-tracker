rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Anonymous users count as signed in.
    function signedIn() { return request.auth != null; }

    // Admin uids — keep in sync with VITE_ADMIN_UIDS. Changing this requires `npm run deploy:rules`.
    function isAdmin() { return signedIn() && request.auth.uid in ['lZnbYJhKdjQi6CDr3m23v2mmSGF2']; }

    // Google-linked (non-anonymous) account: required for handles, friends and offers.
    function realAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    function validSide(s) {
      return s.keys().hasOnly(['playerId', 'protocols', 'compiled'])
        && s.playerId is string && s.playerId.size() >= 1 && s.playerId.size() <= 64
        && s.protocols is list && s.protocols.size() == 3
        && s.protocols.toSet().size() == 3
        && s.compiled is list && s.compiled.size() <= 3
        && s.protocols.toSet().hasAll(s.compiled);
    }

    function loserKey(d) { return d.winner == 'p1' ? 'p2' : 'p1'; }

    function validGame(d) {
      return d.keys().hasOnly(['schemaVersion', 'ownerUid', 'playedAt', 'yearMonth', 'p1', 'p2',
                               'winner', 'firstPlayer', 'compileUnknown', 'allProtocols', 'isTestData', 'createdAt'])
        && d.schemaVersion == 1
        && d.ownerUid == request.auth.uid
        && d.playedAt is timestamp
        && d.yearMonth is string && d.yearMonth.size() == 7
        && validSide(d.p1) && validSide(d.p2)
        && d.winner in ['p1', 'p2']
        // winner compiled all three of its protocols
        && d[d.winner].compiled.toSet() == d[d.winner].protocols.toSet()
        // loser compiled 0–2
        && d[loserKey(d)].compiled.size() < 3
        && (!('firstPlayer' in d) || d.firstPlayer in ['p1', 'p2'])
        // winner only: the loser's compiled protocols were not recorded
        && (!('compileUnknown' in d) || (d.compileUnknown == true && d[loserKey(d)].compiled.size() == 0))
        && d.allProtocols is list && d.allProtocols.size() == 6
        // 6 distinct protocols across both sides
        && d.allProtocols.toSet().size() == 6
        && d.allProtocols.toSet() == d.p1.protocols.toSet().union(d.p2.protocols.toSet())
        && d.isTestData is bool;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /players/{pid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'createdAt', 'archived'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40;
      }

      // Mutual friendship: each account holds users/{me}/friends/{them}. The adder writes both docs in one batch;
      // the mirror doc in the other account may only carry `since`. Either side may delete either doc.
      match /friends/{fid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if realAccount() && fid != uid
          && request.resource.data.since == request.time
          && (
            (request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['since', 'playerId'])
              && (!('playerId' in request.resource.data) || validPlayerRef(request.resource.data.playerId))
              && exists(/databases/$(db)/documents/profiles/$(fid)))
            || (request.auth.uid == fid
              && request.resource.data.keys().hasOnly(['since'])
              && exists(/databases/$(db)/documents/profiles/$(uid))
              && existsAfter(/databases/$(db)/documents/users/$(fid)/friends/$(uid)))
          );
        allow update: if realAccount()
          && request.resource.data.keys().hasOnly(['since', 'playerId'])
          && (
            (request.auth.uid == uid
              && request.resource.data.since == resource.data.since
              && (!('playerId' in request.resource.data) || validPlayerRef(request.resource.data.playerId)))
            // re-adding: the other side refreshes `since` on the mirror doc, keeping any player link
            || (request.auth.uid == fid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['since'])
              && request.resource.data.since == request.time
              && existsAfter(/databases/$(db)/documents/users/$(fid)/friends/$(uid)))
          );
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
      }

      // Games another account offers to {uid}: the owner writes the side fields while they are friends,
      // only {uid} decides (`status`). Doc id = game id.
      match /offers/{gid} {
        allow get: if signedIn()
          && (request.auth.uid == uid || resource == null || resource.data.ownerUid == request.auth.uid);
        allow list: if signedIn() && (request.auth.uid == uid || resource.data.ownerUid == request.auth.uid);
        allow create: if realAccount() && request.auth.uid != uid
          && validOffer(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid));
        allow update: if realAccount() && validOffer(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (
            (request.auth.uid == resource.data.ownerUid
              && request.resource.data.status == resource.data.status
              && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid)))
            || (request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          );
        allow delete: if signedIn() && (request.auth.uid == uid || resource.data.ownerUid == request.auth.uid);
      }
    }

    function validPlayerRef(p) { return p is string && p.size() >= 1 && p.size() <= 64; }

    function validOffer(d) {
      return d.keys().hasOnly(['ownerUid', 'friendSide', 'ownerSide', 'status', 'offeredAt'])
        && d.ownerUid is string
        && d.friendSide in ['p1', 'p2']
        && (!('ownerSide' in d) || (d.ownerSide in ['p1', 'p2'] && d.ownerSide != d.friendSide))
        && d.status in ['pending', 'accepted', 'declined']
        && d.offeredAt is timestamp;
    }

    // Public handles of real accounts. handles/{handle} = { uid } makes them unique; profiles/{uid} = { handle }.
    // Both are written together in one batch (claim / change) and must point at each other.
    function validHandle(h) { return h is string && h.matches('^[a-z0-9_]{3,20}$'); }

    match /handles/{h} {
      allow get: if signedIn();
      allow create: if realAccount() && validHandle(h)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/profiles/$(request.auth.uid)).data.handle == h;
      allow delete: if realAccount() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(db)/documents/profiles/$(request.auth.uid))
            || getAfter(/databases/$(db)/documents/profiles/$(request.auth.uid)).data.handle != h);
    }

    match /profiles/{pid} {
      allow get: if signedIn();
      allow create, update: if realAccount() && request.auth.uid == pid
        && request.resource.data.keys().hasOnly(['handle'])
        && validHandle(request.resource.data.handle)
        && getAfter(/databases/$(db)/documents/handles/$(request.resource.data.handle)).data.uid == pid;
    }

    match /games/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && validGame(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && validGame(request.resource.data);
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.isTestData == true
            || isAdmin());
    }

    // Cookie-free analytics counters: analytics/{day}/counters/{kind}_{source} = { day, n }.
    // Anyone signed in may add exactly +1 to a whitelisted counter; only admins can read them.
    // Keep kinds in sync with COUNTER_KINDS (src/stats/growth.ts) and sources with SOURCES (src/analytics/source.ts).
    function validCounter(day, cid) {
      return day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && cid.matches('^(visit|newUser|game|link)_(reddit|bgg|pwa|search|social|other|direct)$')
        && request.resource.data.keys().hasOnly(['day', 'n'])
        && request.resource.data.day == day
        && request.resource.data.n is int;
    }

    // All-time number of Google-linked (non-anonymous) accounts, no source split: analytics/total/counters/link = { day: 'total', n }.
    function validTotal(day, cid) {
      return day == 'total' && cid == 'link'
        && request.resource.data.keys().hasOnly(['day', 'n'])
        && request.resource.data.day == 'total'
        && request.resource.data.n is int;
    }

    match /analytics/{day}/counters/{cid} {
      allow create: if signedIn() && (validCounter(day, cid) || validTotal(day, cid)) && request.resource.data.n == 1;
      allow update: if signedIn() && (validCounter(day, cid) || validTotal(day, cid)) && request.resource.data.n == resource.data.n + 1;
    }

    match /{path=**}/counters/{cid} {
      allow read: if isAdmin();
    }

    // Reserved for the precomputed-stats fallback.
    match /stats/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
